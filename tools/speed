#!/bin/sh
# Spec: none - M6's speed measure (D8): each tests/speed/*.cpp built once by cpp11 -O2 and linked twice,
# against rts6x.lib and TI's rts6740_elf_eh.lib, both images run on the CCS 5.5 C6747 cycle-accurate
# simulator on the Windows box. The two outputs must agree (or rts6x match a NAME.expected, the host's exact answer); the cycles are compared, rts6x over TI.
#   tools/speed            every benchmark        ONLY=word tools/speed      those named so
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
CPP=$(cd "$ROOT/../C++Optimize" && pwd)
CPP11=${CPP11:-$CPP/cpp11.exe}; ASM6X=${ASM6X:-$ROOT/../ASM6x/build/asm6x.exe}
LNK6X=${LNK6X:-$ROOT/../LNK6x/build/lnk6x.exe}; TILIB=${TILIB:-$HOME/c6747-lib}
WINDOWS=${CXX1_WINDOWS:-windows}; REMOTE='C:\cxx1\referee'
WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/ref"
for f in runca.js par-one.cmd c6747ca-windows.ccxml; do cp "$CPP/tools/c6747/$f" "$WORK/ref/"; done
cp "$ROOT/tools/referee.cmd" "$WORK/ref/"
# The flat map the suites link with (tests/tms6747.sh), DDR at 0xC0000000.
printf '%s\n' '--rom_model' '--stack_size=0x100000' '--heap_size=0x100000' \
  'MEMORY { RAM : origin = 0xC0000000, length = 0x04000000 }' \
  'SECTIONS { .text > RAM .const > RAM .data > RAM .bss > RAM .far > RAM .fardata > RAM .neardata > RAM' \
  '  .rodata > RAM .cinit > RAM .init_array > RAM .switch > RAM .cio > RAM .stack > RAM .sysmem > RAM }' > "$WORK/link.cmd"
NAMES=""
for src in "$ROOT"/tests/speed/*.cpp; do
    n=$(basename "$src" .cpp)
    case "$n" in *"${ONLY:-}"*) ;; *) continue ;; esac
    if "$CPP11" -arch tms6747 -nologo -O2 -S "$src" -o "$WORK/$n.s" > "$WORK/$n.log" 2>&1 &&
       "$ASM6X" "$WORK/$n.s" -o "$WORK/$n.obj" >> "$WORK/$n.log" 2>&1 &&
       "$LNK6X" -mv6740 --abi=eabi -i "$ROOT/build" "$WORK/link.cmd" "$WORK/$n.obj" -l rts6x.lib -o "$WORK/ref/$n.rts6x.out" >> "$WORK/$n.log" 2>&1 &&
       "$LNK6X" -mv6740 --abi=eabi -i "$TILIB" "$WORK/link.cmd" "$WORK/$n.obj" -l rts6740_elf_eh.lib -o "$WORK/ref/$n.ti.out" >> "$WORK/$n.log" 2>&1
    then NAMES="$NAMES $n"; else echo "speed: $n did not build:"; head -4 "$WORK/$n.log" | sed 's/^/      /'; fi
done
COPYFILE_DISABLE=1 tar -C "$WORK" --no-xattrs -czf "$WORK/ref.tgz" ref || exit 1
scp -q -o BatchMode=yes "$WORK/ref.tgz" "$WINDOWS:C:/cxx1/ref.tgz" || { echo "speed: cannot ship to $WINDOWS"; exit 1; }
ssh -o BatchMode=yes "$WINDOWS" "rmdir /s /q $REMOTE 2>nul & mkdir $REMOTE && tar -C $REMOTE --strip-components=1 -xzf C:\\cxx1\\ref.tgz && del C:\\cxx1\\ref.tgz" >/dev/null 2>&1 || exit 1
ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\referee.cmd" > "$WORK/windows.log" 2>&1
mkdir -p "$WORK/back"; scp -q -o BatchMode=yes "$WINDOWS:C:/cxx1/referee/out/*" "$WORK/back/" 2>/dev/null
field() { tr -d '\r' < "$1" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1; }
printf '%-14s %14s %14s %7s  %s\n' benchmark rts6x TI ratio output
for n in $NAMES; do
    a=$(field "$WORK/back/$n.rts6x.result" count); b=$(field "$WORK/back/$n.ti.result" count)
    same=agree; cmp -s "$WORK/back/$n.rts6x.stdout" "$WORK/back/$n.ti.stdout" || same=DIFFER
    # A .expected is the host's exact answer (docs/TI-DIFFERENCES.md): rts6x is held to it, TI only reported.
    exp="$ROOT/tests/speed/$n.expected"
    if [ -f "$exp" ] && [ "$same" = DIFFER ]; then
        r=WRONG; tr -d '\r' < "$WORK/back/$n.rts6x.stdout" | cmp -s - "$exp" && r=exact
        t=wrong; tr -d '\r' < "$WORK/back/$n.ti.stdout" | cmp -s - "$exp" && t=exact
        same="rts6x $r, TI $t"; [ "$r" = exact ] && [ "$t" = wrong ] && same="agree with .expected (TI differs, as docs/TI-DIFFERENCES.md says)"
    fi
    ratio=-; [ -n "$a" ] && [ -n "$b" ] && ratio=$(awk "BEGIN { printf \"%.2f\", $a / $b }")
    printf '%-14s %14s %14s %7s  %s\n' "$n" "${a:--}" "${b:--}" "$ratio" "$same"
    case "$same" in agree*) ;; *) false ;; esac || { tr -d '\r' < "$WORK/back/$n.rts6x.stdout"; tr -d '\r' < "$WORK/back/$n.ti.stdout"; } | sed 's/^/      /'
done
