#!/bin/sh
# Spec: none - M6's referee (docs/ORGANISATION.md 5): the images both tms6747 suites link against
# rts6x.lib run on TI's own CCS 5.5 C6747 cycle-accurate simulator, on the Windows box, and their
# output and exit status are compared with sim6747's, which the suites have already held to expected.
#   tools/referee              both suites, rebuilt at -O2      tools/referee cpp11|c90    one of them
#   KEEP=1 tools/referee       the suites' images as they are, not rebuilt; ONLY=word, the images named so
#   PREPARE=dir tools/referee  stop with the images and sim6747's answers in dir (a box with no route
#   to Windows builds and runs them); FROM=dir tools/referee  ship and judge what PREPARE left there
#   tools/referee --record [file.md]   also write the verdict into the tree, default docs/REFEREE-<date>.md:
#   the heads of the four trees, the counts, and one row per image - id, verdict, TI's cycles and status
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
RECORD=""; ARGS=""
while [ $# -gt 0 ]; do
    case $1 in
    --record) RECORD="$ROOT/docs/REFEREE-$(date +%Y-%m-%d).md"
              case ${2:-} in *.md) RECORD=$2; shift ;; esac ;;
    *) ARGS="$ARGS $1" ;;
    esac
    shift
done
# shellcheck disable=SC2086 - the remaining words are the suite's name, if one was given
set -- $ARGS
CPP=$(cd "$ROOT/../C++Optimize" && pwd); C90=$(cd "$ROOT/../VM6747/Compiler-Ci" && pwd)
SIM6747=${SIM6747:-$ROOT/../SIM6747/sim6747.exe}
WINDOWS=${CXX1_WINDOWS:-windows}; REMOTE='C:\cxx1\referee'
WHICH=${1:-both}; T0=$(date +%s)
WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/ref" "$WORK/vm"
for f in runca.js par-one.cmd c6747ca-windows.ccxml; do cp "$CPP/tools/c6747/$f" "$WORK/ref/"; done
cp "$ROOT/tools/referee.cmd" "$WORK/ref/"

# The suites' images, rebuilt at -O2 against this checkout's library unless KEEP or FROM says otherwise.
if [ -z "${FROM:-}" ] && [ "${KEEP:-0}" != 1 ]; then
    [ "$WHICH" = c90 ] || (cd "$CPP" && CXX1_FLAGS=-O2 TIRTS="$ROOT/build" RTSLIB=rts6x.lib sh tests/tms6747.sh | tail -2)
    if [ "$WHICH" != cpp11 ]; then
        printf '#!/bin/sh\nexec %s -O2 "$@"\n' "$C90/c90.exe" > "$WORK/c90-O2"; chmod +x "$WORK/c90-O2"
        (cd "$C90" && CC1="$WORK/c90-O2" TIRTS="$ROOT/build" RTSLIB=rts6x.lib sh tests/tms6747.sh | tail -2)
    fi
fi
take() {   # suite prefix, image: copied with sim6747's own output and status beside it
    id=$1.$(basename "$2" .ti.out)
    case "$id" in *"${ONLY:-}"*) ;; *) return ;; esac
    "$SIM6747" --dis "$2" 2>/dev/null | grep -q __rts6x_halt || { echo "referee: $2 is not linked with rts6x.lib"; return; }
    cp "$2" "$WORK/ref/$id.out"
    ( ulimit -t 60 2>/dev/null; "$SIM6747" --run "$2" ) > "$WORK/vm/$id.out" 2>&1 < /dev/null; echo $? > "$WORK/vm/$id.rc"
}
if [ -n "${FROM:-}" ]; then cp "$FROM"/ref/*.out "$WORK/ref/" && cp "$FROM"/vm/* "$WORK/vm/" || exit 1
else
    [ "$WHICH" = c90 ] || for i in "$CPP"/tests/out-tms6747/*.ti.out; do take p "$i"; done
    [ "$WHICH" = cpp11 ] || for i in "$C90"/tests/out-tms6747/*.ti.out; do take c "$i"; done
fi
if [ -n "${PREPARE:-}" ]; then mkdir -p "$PREPARE" && cp -R "$WORK/ref" "$WORK/vm" "$PREPARE/" && echo "referee: prepared in $PREPARE"; exit 0; fi
N=$(ls "$WORK/ref"/*.out | wc -l | tr -d ' ')
echo "referee: $N images, shipping to $WINDOWS for TI's C6747 simulator"

COPYFILE_DISABLE=1 tar -C "$WORK" --no-xattrs -czf "$WORK/ref.tgz" ref || exit 1
scp -q -o BatchMode=yes "$WORK/ref.tgz" "$WINDOWS:C:/cxx1/ref.tgz" || { echo "referee: cannot ship to $WINDOWS"; exit 1; }
ssh -o BatchMode=yes "$WINDOWS" "rmdir /s /q $REMOTE 2>nul & mkdir $REMOTE && tar -C $REMOTE --strip-components=1 -xzf C:\\cxx1\\ref.tgz && del C:\\cxx1\\ref.tgz" >/dev/null 2>&1 || { echo "referee: cannot unpack on $WINDOWS"; exit 1; }
ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\referee.cmd" > "$WORK/windows.log" 2>&1
mkdir -p "$WORK/back"
scp -q -o BatchMode=yes "$WINDOWS:C:/cxx1/referee/out/*" "$WORK/back/" 2>/dev/null
[ -f "$WORK/back/referee.done" ] || { echo "referee: the Windows worker did not finish"; tr -d '\r' < "$WORK/windows.log" | tail -8; exit 1; }

# The verdict: TI's output against sim6747's, and the status A4 holds at C$$EXIT against sim6747's.
field() { tr -d '\r' < "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1; }
agree=0; differ=0; norun=0
for o in "$WORK/ref"/*.out; do
    id=$(basename "$o" .out); r="$WORK/back/$id.result"
    count=$(field "$r" count 2>/dev/null); pc=$(field "$r" pc 2>/dev/null); ex=$(field "$r" exit 2>/dev/null); a4=$(field "$r" a4 2>/dev/null)
    if [ -z "$count" ]; then echo "NO RUN  $id: $(tr -d '\r' < "$r" 2>/dev/null | tr '\n' ' ' | sed 's/^BOX [^ ]* //')"; norun=$((norun+1))
        echo "| $id | did not run | - | - |" >> "$WORK/rows"; continue; fi
    tr -d '\r' < "$WORK/back/$id.stdout" 2>/dev/null > "$WORK/$id.ti" || : > "$WORK/$id.ti"
    want=$(cat "$WORK/vm/$id.rc"); got=$(( ${a4:-0} & 255 ))
    if [ "$pc" = "$ex" ] && [ "$got" = "$want" ] && cmp -s "$WORK/$id.ti" "$WORK/vm/$id.out"; then agree=$((agree+1))
        echo "| $id | agree | $count | $got |" >> "$WORK/rows"
    else
        differ=$((differ+1)); echo "DIFFER  $id: TI status $got pc $pc, sim6747 status $want"
        diff "$WORK/vm/$id.out" "$WORK/$id.ti" | head -6 | sed 's/^/        /'
        echo "| $id | DIFFER: TI pc $pc, sim6747 status $want | $count | $got |" >> "$WORK/rows"
    fi
done
SUMMARY="referee: $agree agree, $differ differ, $norun did not run - of $N, in $(( $(date +%s) - T0 ))s"
echo "$SUMMARY"
if [ -n "$RECORD" ]; then
    treehead() { git -C "$1" log -1 --format='%h %ad' --date=short 2>/dev/null || echo unknown; }
    {
        echo "# RTS6x's referee, $(date '+%Y-%m-%d %H:%M %Z')"
        echo
        echo "Written by \`tools/referee --record\`: the images the tms6747 suites link against rts6x.lib"
        echo "($WHICH), run on TI's CCS 5.5 C6747 cycle-accurate simulator on the Windows box, their output"
        echo "and exit status against sim6747's. \`p.\` is cpp11's suite, \`c.\` is c90's."
        echo
        echo "| tree | head |"
        echo "| --- | --- |"
        echo "| RTS6x | $(treehead "$ROOT") |"
        echo "| C++Optimize (cpp11) | $(treehead "$CPP") |"
        echo "| VM6747/Compiler-Ci (c90) | $(treehead "$C90") |"
        echo "| SIM6747 | $(treehead "$(dirname "$SIM6747")") |"
        echo
        echo "**$SUMMARY.**"
        echo
        echo "| image | verdict | TI cycles | TI status |"
        echo "| --- | --- | ---: | ---: |"
        sort "$WORK/rows" 2>/dev/null
    } > "$RECORD"
    echo "referee: recorded in $RECORD"
fi
[ $differ -eq 0 ] && [ $norun -eq 0 ]
